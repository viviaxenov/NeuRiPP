{
  "output_root": "results/fashion_ae_64",
  "common_params": {
    "max_iterations": 72000,
    "batch_size": 4096,
    "N_monte_carlo": 4096,
    "master_seed": 42,
    "eval_every": 900
  },
  "problem": {
    "functional": {
      "kind": "CrossEntropy"
    },
    "distribution": {
      "name": "fashion_mnist",
      "resample_each": 1,
      "seed": 3
    }
  },
  "architectures": [
    {
      "rhs": {
        "model": "MLP",
        "n_hidden": 3,
        "dim_hidden": 64,
        "encoder_dim": 64,
        "encoder_path": "./encoder"
      },
      "divergence_method": "hutchinson",
      "ode_nstep_max": 10,
      "ode_method": "rk45",
      "adaptive": true,
      "h_max": 0.3
    }
  ],
  "methods": [
    {
      "method": "ngd",
      "n_restarts": 1,
      "step_size": [0.01, 0.05],
      "natural_grad_clipping_threshold": [100.0, 10.0],
      "linear_solver_regularization": [ 0.01, 0.001, 1e-5],
      "linear_solver_tolerance": 1e-4,
      "linear_solver_maxiter": 50
    } 
  ],
  "plotting": {
    "nrows": 4,
    "ncols": 4,
    "style_channels": {
      "colormap": ["Blues"],
      "linestyle": ["-"],
      "linewidth": [1.5]
    }
  },
  "parallel": {
    "gpu_ids": [0, 1],
    "max_parallel": {
      "ngd": 6,
      "adamw": 3
    }
  }
}
