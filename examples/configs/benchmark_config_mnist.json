{
  "output_root": "results/mnist_ffjord",
  "common_params": {
    "max_iterations": 23500,
    "batch_size": 256,
    "N_monte_carlo": 256,
    "master_seed": 42,
    "eval_every": 470
  },
  "problem": {
    "functional": {
      "kind": "CrossEntropy"
    },
    "distribution": {
      "name": "mnist",
      "resample_each": 1,
      "seed": 3
    }
  },
  "architectures": [
    {
      "rhs": {
        "model": "MLP",
        "n_hidden": 3,
        "dim_hidden": 256,
        "encoder_dim": 64,
        "encoder_path": "./encoder"
      },
      "divergence_method": "hutchinson",
      "ode_nstep_max": 10,
      "ode_method": "rk45",
      "adaptive": true,
      "h_max": 0.3,
      "grad_checkpointing": "dots_only"
    }
  ],
  "methods": [
    {
      "method": "ngd",
      "n_restarts": 1,
      "stepsize_schedule": "schedule_exp",
      "step_size": [0.01, 0.001],
      "drop_every": [100, 150],
      "drop_by": [2.0],
      "natural_grad_clipping_threshold": [0.5],
      "linear_solver_regularization": 0.01,
      "linear_solver_tolerance": 1e-4,
      "linear_solver_maxiter": 50
    },{
      "method": "adam",
      "n_restarts": 1,
      "learning_rate": [1e-3,  1e-5] 
    }
  ],
  "plotting": {
    "nrows": 3,
    "ncols": 3,
    "style_channels": {
      "colormap": ["Blues"],
      "linestyle": ["-"],
      "linewidth": [1.5]
    }
  },
  "parallel": {
    "gpu_ids": [4, 5, 6, 7],
    "max_parallel": {
      "ngd": 1,
      "adam": 2
    }
  }
}
