{
  "output_root": "results/benchmarks",
  "common_params": {
    "max_iterations": 50,
    "batch_size": 16,
    "N_monte_carlo": 16,
    "master_seed": 42,
    "eval_every": 25
  },
  "problem": {
    "functional": {
      "kind": "CrossEntropy"
    },
    "distribution": {
      "name": "checkerboard",
      "resample_each": 25,
      "seed": 3
    }
  },
  "architectures": [
    {
      "rhs": {
        "model": "MLP",
        "dim_hidden": 16,
        "n_hidden": [1],
        "activation": "swish"
      },
      "divergence_method": "hutchinson",
      "ode_nstep_max": 6,
      "ode_method": "rk45",
      "adaptive": true
    }
  ],
  "methods": [
    {
      "method": "anderson",
      "n_restarts": 6,
      "natural_grad_clipping_threshold": [null, 1.0],
      "history_length":  6,
      "regularization_method": ["l2", "adaptive"],
      "ensure_descent": [true],
      "step_size": [0.001],
      "relaxation": 1.0,
      "regularization_factor": [1e-4, 0.001, 0.01],
      "linear_solver_regularization": 0.001,
      "linear_solver_tolerance": 1e-6
    },
    {
      "method": "ngd",
      "n_restarts": 6,
      "natural_grad_clipping_threshold": [null, 1.0],
      "step_size": [0.01],
      "linear_solver_regularization": [0.0001],
      "linear_solver_tolerance": 1e-6
    }
  ],
  "plotting": {
    "style_channels": {
      "colormap": ["Blues", "Oranges"],
      "linestyle": ["-", "--", ":"],
      "linewidth": [1.5, 2.5]
    },
    "style_channel_map": {
      "method": "cmap",
      "step_size": "color",
      "relaxation": "linestyle"
    }
  },
  "parallel": {
    "gpu_ids": [6, 7],
    "max_parallel": {
      "anderson": 15,
      "ngd": 96,
      "adamw": 120
    }
  }
}
