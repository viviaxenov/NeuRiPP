{
  "extends": "_base_pixel.json",
  "experiment": {"name": "vae_base"},
  "problem": {
    "dataset": {"name": "flowers102", "resolution": 256, "horizontal_flip": false},
    "encoder": {"type": "vae", "implementation": "diffusers", "checkpoint_id": "stabilityai/sd-vae-ft-mse", "sample_posterior": true, "cache_latents": true, "latent_cache_dir": "../../../artifacts/latents"}
  },
  "rhs": {"type": "unet", "variant": "small"},
  "training": {"batch_size": 128},
  "evaluation": {"split": "test", "kid": {"enabled": true, "subsets": 100, "subset_size": 1000}}
}
