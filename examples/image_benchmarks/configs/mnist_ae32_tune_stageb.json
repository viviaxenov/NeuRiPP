{
  "extends": "mnist_ae32_mlp.json",
  "experiment": {"name": "mnist_ae32_tune_stageB", "seed": 42},
  "ema": {"enabled": true, "decay": 0.9999, "start_step": 0},
  "training": {
    "max_steps": 23400,
    "target_loader_epochs": 100,
    "batch_size": 256,
    "log_every": 10,
    "validation_every": 300,
    "checkpoint_every": 2340,
    "keep_checkpoints": 3
  },
  "methods": [
    {"name": "adamw", "n_restarts": 1, "kwargs": {"learning_rate": 0.001, "weight_decay": 0.0, "b1": 0.9}},
    {"name": "ngd", "n_restarts": 1, "kwargs": {"step_size": 0.001, "linear_solver_regularization": 0.01, "linear_solver_tolerance": 1e-6, "linear_solver_maxiter": 50}},
    {"name": "ngd", "n_restarts": 1, "kwargs": {"step_size": 0.01, "linear_solver_regularization": 0.01, "linear_solver_tolerance": 1e-6, "linear_solver_maxiter": 50, "natural_grad_clipping_threshold": 20.0}},
    {"name": "adamw", "n_restarts": 1, "kwargs": {"learning_rate": 0.003, "weight_decay": 0.0, "b1": 0.9}},
    {"name": "adamw", "n_restarts": 1, "kwargs": {"learning_rate": 0.003, "weight_decay": 0.0, "b1": 0.95}}
  ],
  "evaluation": {
    "split": "test",
    "seed": 1042,
    "val_fm_loss": {"enabled": true, "num_samples": 5000, "batch_size": 256},
    "sampling": {"method": "heun", "steps": 50, "batch_size": 256},
    "fid": {"enabled": false},
    "kid": {"enabled": false},
    "sw_validation": {
      "enabled": true,
      "num_samples": 3000,
      "batch_size": 256,
      "num_projections": 100
    },
    "sample_metrics": {
      "num_samples": 3000,
      "batch_size": 256,
      "mmd": {"enabled": false},
      "sliced_wasserstein": {"enabled": true, "num_projections": 100}
    }
  },
  "resources": {
    "gpu_ids": [0, 1, 2, 3, 4, 5, 6, 7],
    "gpus_per_run": 1,
    "max_concurrent_runs": 8,
    "data_parallel": true,
    "worker_env": {"XLA_PYTHON_CLIENT_MEM_FRACTION": "0.9"}
  },
  "plotting": {
    "sample_grid": {"enabled": true, "rows": 8, "columns": 8},
    "top_runs_per_method": 5,
    "style_channels": {
      "colormap": ["tab10", "Set2"],
      "linestyle": ["-", "--", ":"],
      "linewidth": [1.0, 1.5, 2.0]
    },
    "style_channel_map": {
      "method": "cmap",
      "step_size": "linestyle",
      "learning_rate": "linestyle",
      "linear_solver_regularization": "color",
      "natural_grad_clipping_threshold": "linewidth",
      "weight_decay": "color",
      "b1": "color"
    }
  }
}
