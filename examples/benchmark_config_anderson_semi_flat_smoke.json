{
  "output_root": "results/benchmark_anderson_semi_flat_smoke",
  "common_params": {
    "max_iterations": 2,
    "batch_size": 4,
    "N_monte_carlo": 4,
    "master_seed": 42,
    "eval_every": 1
  },
  "problem": {
    "functional": {
      "kind": "CrossEntropy"
    },
    "distribution": {
      "name": "checkerboard",
      "resample_each": 1,
      "seed": 3
    }
  },
  "architectures": [
    {
      "rhs": {
        "model": "MLP",
        "dim_hidden": 8,
        "n_hidden": 1,
        "activation": "tanh"
      },
      "divergence_method": "hutchinson",
      "ode_nstep_max": 4,
      "ode_method": "euler"
    }
  ],
  "methods": [
    {
      "method": "anderson",
      "n_restarts": 1,
      "semi_flat": [false, true],
      "stepsize_schedule": "schedule_exp",
      "history_length": 4,
      "regularization_method": "l2",
      "ensure_descent": true,
      "step_size": [0.001],
      "drop_every": [2],
      "drop_by": [2.0],
      "relaxation": 1.0,
      "regularization_factor": [0.001],
      "natural_grad_clipping_threshold": [1.0],
      "linear_solver_regularization": 0.001,
      "linear_solver_tolerance": 1e-6
    }
  ],
  "plotting": {
    "style_channels": {
      "colormap": ["Blues", "Oranges"],
      "linestyle": ["-", "--"],
      "linewidth": [1.5]
    }
  },
  "parallel": {
    "gpu_ids": [0],
    "max_parallel": {
      "anderson": 2
    }
  }
}
