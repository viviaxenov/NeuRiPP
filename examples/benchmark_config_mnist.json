{
  "output_root": "results/benchmarks",
  "common_params": {
    "max_iterations": 50,
    "batch_size": 64,
    "N_monte_carlo": 64,
    "master_seed": 42,
    "eval_every": 10
  },
  "problem": {
    "functional": {
      "kind": "CrossEntropy"
    },
    "distribution": {
      "name": "fashion_mnist",
      "resample_each": 1,
      "seed": 3
    }
  },
  "architectures": [
    {
      "rhs": {
        "model": "CFMConv2D",
        "n_channels": 32,
        "n_hidden": 2
      },
      "divergence_method": "hutchinson",
      "ode_nstep_max": 5,
      "ode_method": "euler",
      "grad_checkpointing": false
    }
  ],
  "methods": [
    {
      "method": "ngd",
      "n_restarts": 1,
      "stepsize_schedule": "schedule_exp",
      "step_size": [0.001],
      "drop_every": [100],
      "drop_by": [2.0],
      "natural_grad_clipping_threshold": [0.1],
      "linear_solver_regularization": 0.01,
      "linear_solver_tolerance": 1e-6
    }
  ],
  "plotting": {
    "nrows": 3,
    "ncols": 3,
    "style_channels": {
      "colormap": ["Blues"],
      "linestyle": ["-"],
      "linewidth": [1.5]
    }
  },
  "parallel": {
    "gpu_ids": [0],
    "max_parallel": {
      "ngd": 1
    }
  }
}
